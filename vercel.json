{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/catalog", "destination": "/catalog/", "permanent": false }
  ],
  "headers": [
    { "source": "/files/(.*)", "headers": [ { "key": "Content-Disposition", "value": "inline" } ] },
    { "source": "/pages/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ]
}
